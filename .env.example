# ── Server ────────────────────────────────────────────────
PORT=4000
PUBLIC_URL=http://localhost:4000
JWT_SECRET=change-me-in-production

# ── Database ──────────────────────────────────────────────
# Default: MySQL/MariaDB (XAMPP works out of the box).
# If MySQL is unreachable the server falls back to built-in SQLite automatically.
DATABASE_URL=mysql://root@127.0.0.1:3306/livechat
# PostgreSQL also supported:
# DATABASE_URL=postgres://user:pass@host:5432/livechat

# ── Redis (optional, for multi-node scaling + presence) ──
# REDIS_URL=redis://localhost:6379

# ── File storage ──────────────────────────────────────────
# Local disk by default (apps/server/storage). For S3:
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Virus scanning ────────────────────────────────────────
# If clamdscan/clamscan is installed it is used automatically.
# Set to "strict" to BLOCK uploads when no scanner is available.
# SCAN_MODE=permissive

# ── AI greeter (queue assistant) ──────────────────────────
# While the customer waits in the queue, an AI assistant chats with them.
# With an Anthropic API key it uses Claude; without it, a built-in
# rule-based assistant replies. Set AI_GREETER=off to disable.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# AI_GREETER=on

# ── Email transcripts (SMTP) ──────────────────────────────
# When configured, visitors who shared an email get a branded
# transcript when their conversation closes.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# SMTP_FROM="Acme Support <support@example.com>"

# ── Calls ─────────────────────────────────────────────────
# With a Daily.co API key, calls use Daily rooms + webhooks.
# Without it, built-in P2P WebRTC calling (Socket.IO signaling) is used.
# DAILY_API_KEY=
